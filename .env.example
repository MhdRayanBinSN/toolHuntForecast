# Initial and fallback research category.
CATEGORY=software tools

# Discovery token: required to find candidates through Product Hunt.
PRODUCTHUNT_TOKEN=

# Optional integrations, reserved for pipeline features not wired in yet.
SAASHUB_API_KEY=
GEMINI_API_KEY=

# Optional tuning.
MAX_PAGES_PER_PRODUCT=5
USER_AGENT=ProductResearchBot/1.0 (+you@example.com)
DATABASE_URL=sqlite:///data/app.db
